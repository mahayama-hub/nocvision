# Google Gemini API Configuration for NOCVISION NOCAI
# Salin file ini menjadi .env.local lalu isi GEMINI_API_KEY dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Session signing secret (wajib diisi minimal 32 karakter acak pada deployment production)
SESSION_SECRET=


